# Exemplo operacional HOMO — NÃO commitar valores reais.
# No servidor: /etc/hits-gateway/hits-gateway.env
# Permissões: root:hits-gateway 0640
#
# Gerar GATEWAY_TOKEN (HOMO ≠ PROD):
#   openssl rand -hex 32
#
# Sem credenciais HITS a aplicação sobe; GET /v1/* autenticado responde 503.
# Não inventar URL/secret da APP Sistemas.

NODE_ENV=production
PORT=3001

GATEWAY_TOKEN=

HITS_API_BASE_URL=
HITS_SHARED_ACCESS_SECRET=
HITS_PROPERTY_ID=
HITS_TENANT_NAME=
HITS_PROPERTY_CODE=
HITS_CLIENT_ID=
HITS_PARTNER_USER_ID=
HITS_API_VERSION=1
HITS_LANGUAGE_CODE=pt-BR
HITS_AUTHORIZE_SCOPES=WebCheckIn
HITS_REQUEST_TIMEOUT_MS=12000

# Escrita PAX sandbox. Deixar vazio/desligado em produção.
# Homologação: exatamente true, e somente se HITS_TENANT_NAME=dev.
HITS_GUEST_WRITE_ENABLED=
