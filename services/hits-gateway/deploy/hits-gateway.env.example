# Exemplo operacional (HOMO e PROD usam o MESMO artefato) — NÃO commitar valores reais.
# No servidor: /etc/hits-gateway/hits-gateway.env
# Permissões: root:hits-gateway 0640
#
# Gerar GATEWAY_TOKEN (HOMO ≠ PROD):
#   openssl rand -hex 32
#
# Sem credenciais HITS a aplicação sobe; GET /v1/* autenticado responde 503.
# Não inventar URL/secret da APP Sistemas.
#
# PRODUÇÃO (hits-prod.yeshotel.com.br / 167.172.2.24) — somente leitura:
#   HITS_TENANT_NAME=yeshotel, HITS_PROPERTY_CODE=1, HITS_AUTHORIZE_SCOPES=WebCheckIn.
#   HITS_SHARED_ACCESS_SECRET e HITS_PROPERTY_ID: valores enviados pela HITS,
#   preenchidos à mão no servidor (sudoedit) — nunca via echo/argumento de shell.
#   HITS_GUEST_WRITE_ENABLED: deixar VAZIO. Com tenant yeshotel a escrita PAX
#   fica bloqueada mesmo se a flag for true. Não existe flag de check-in.
#   Editar este env NÃO liga a leitura de produção no Yes: isso depende da
#   Edge (HITS_GATEWAY_URL + HITS_GATEWAY_PROD_READ_ENABLED=true), só após
#   o /health de produção validado.

NODE_ENV=production
PORT=3001

GATEWAY_TOKEN=

HITS_API_BASE_URL=
HITS_SHARED_ACCESS_SECRET=
HITS_PROPERTY_ID=
HITS_TENANT_NAME=
HITS_PROPERTY_CODE=
HITS_CLIENT_ID=
HITS_PARTNER_USER_ID=
HITS_API_VERSION=1
HITS_LANGUAGE_CODE=pt-BR
HITS_AUTHORIZE_SCOPES=WebCheckIn
HITS_REQUEST_TIMEOUT_MS=12000

# Escrita PAX sandbox. Deixar vazio/desligado em produção.
# Homologação: exatamente true, e somente se HITS_TENANT_NAME=develop.
HITS_GUEST_WRITE_ENABLED=
