# Gateway HITS — desenvolvimento. Nunca commitar valores reais.
# Operação no servidor: ver deploy/hits-gateway.env.example
#
# Nomes HITS alinhados a src/lib/integrations/hits/config.ts.
# NÃO usar: HITS_BASE_URL, HITS_ACCESS_SECRET, HITS_TENANT, HITS_PARTNER_ID.

NODE_ENV=production
PORT=3001

# Obrigatório. Mínimo 32 caracteres. Recomendado:
#   openssl rand -hex 32
GATEWAY_TOKEN=

# Sem default de produção neste serviço. Sandbox: A CONFIRMAR com APP Sistemas.
HITS_API_BASE_URL=

HITS_SHARED_ACCESS_SECRET=
HITS_PROPERTY_ID=
HITS_TENANT_NAME=
HITS_PROPERTY_CODE=
HITS_CLIENT_ID=
HITS_PARTNER_USER_ID=

HITS_API_VERSION=1
HITS_LANGUAGE_CODE=pt-BR
HITS_REQUEST_TIMEOUT_MS=12000
# HITS_AUTHORIZE_SCOPES=WebCheckIn
