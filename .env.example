# HITS PMS API (preparada e DESLIGADA por padr�o)
# Documenta��o: https://api.hitspms.net/  |  docs/HITS_API_INTEGRATION.md
# N�O usar prefixo NEXT_PUBLIC_*. Shared secret somente server-side.
HITS_API_BASE_URL=https://api.hitspms.net
HITS_SHARED_ACCESS_SECRET=
HITS_PROPERTY_ID=
HITS_INTEGRATION_ENABLED=false
HITS_CHECKIN_ENABLED=false
HITS_REQUEST_TIMEOUT_MS=12000

# --- Sync de reservas HITS (DESLIGADO por padrao; modo mock) ---
# docs/YES_HOTEL_HITS_RESERVATION_SYNC_CHEGADAS_V1.md
# Sem NEXT_PUBLIC_*. Nao ativar sem gate humano. Sem cron neste PR.
HITS_RESERVATION_SYNC_ENABLED=false
HITS_RESERVATION_SYNC_MODE=mock
HITS_RESERVATION_SYNC_BATCH_SIZE=100
HITS_RESERVATION_SYNC_INTERVAL_SECONDS=120
# Persistencia Supabase (DESLIGADA). Exige migration aplicada + gate humano.
HITS_RESERVATION_SYNC_PERSISTENCE_ENABLED=false
HITS_RESERVATION_SCHEMA_READY=false
# Token opcional para invocacao manual da Edge hits-reservation-sync (alem de service_role).
# HITS_RESERVATION_SYNC_TOKEN=

# Contexto Datashare (headers Swagger) ? preencher somente ap�s confirma��o HITS
HITS_API_VERSION=1
HITS_TENANT_NAME=
HITS_PROPERTY_CODE=
HITS_PARTNER_USER_ID=
HITS_CLIENT_ID=
HITS_LANGUAGE_CODE=pt-BR
# Escopos do /authorize (CSV). Default interno: WebCheckIn
# HITS_AUTHORIZE_SCOPES=WebCheckIn

# --- Ciclo toler�ncia / suspens�o / outbox (DESLIGADO por padr�o) ---
# docs/YES_HOTEL_ACCESS_TOLERANCE_CYCLE.md
# Sem NEXT_PUBLIC_*. N�o ativar em produ��o sem gate humano.
# Defaults: processador/TTLock/dispatcher/DigiSac/e-mail = false (fail-closed).
YES_HOTEL_ACCESS_TOLERANCE_PROCESSOR_ENABLED=false
YES_HOTEL_TTLOCK_SUSPENSION_ENABLED=false
YES_HOTEL_ACCESS_OUTBOX_DISPATCH_ENABLED=false
YES_HOTEL_ACCESS_DIGISAC_REAL_ENABLED=false
YES_HOTEL_ACCESS_EMAIL_REAL_ENABLED=false
# Obrigat�rio para execu��o TTLock real (fail-closed se ausente).
# YES_HOTEL_TTLOCK_HOMOLOG_LOCK_ID=
# YES_HOTEL_DIGISAC_INTERNAL_NUMBER=
# ACCESS_TOLERANCE_PROCESSOR_TOKEN=
# DigiSac: aus�ncia de DIGISAC_USE_MOCK N�O ativa envio real (default mock/fail-closed).
# DIGISAC_USE_MOCK=true

# Legado (n�o usar em c�digo novo; preferir HITS_API_BASE_URL / HITS_SHARED_ACCESS_SECRET)
# HITS_BASE_URL=
# HITS_ACCESS_SECRET=

# TTLock Open Platform (Fase TTLock 2 - passcode tempor�rio)
# Obtenha em open.ttlock.com / euopen.ttlock.com
TTLOCK_CLIENT_ID=
TTLOCK_CLIENT_SECRET=
TTLOCK_USERNAME=
TTLOCK_PASSWORD=
# Opcional; padr�o: euapi.ttlock.com
# TTLOCK_TOKEN_URL=https://euapi.ttlock.com/oauth2/token
# TTLOCK_API_BASE_URL=https://euapi.ttlock.com

# Supabase (scripts de provisionamento)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp ? MVP 3 Fase 4.2 (Meta Cloud API)
# true = mock (padr�o); false = Meta Cloud API real
WHATSAPP_USE_MOCK=true
# Meta Cloud API (obrigat�rios quando USE_MOCK=false)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Opcional; default: v21.0
WHATSAPP_GRAPH_API_VERSION=v21.0
# Webhook Meta: verifica��o GET (hub.verify_token) e assinatura POST (X-Hub-Signature-256)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
