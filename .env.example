# HITS PMS API (preparada e DESLIGADA por padrão)
# Documentação: https://api.hitspms.net/  |  docs/HITS_API_INTEGRATION.md
# NÃO usar prefixo NEXT_PUBLIC_*. Shared secret somente server-side.
HITS_API_BASE_URL=https://api.hitspms.net
HITS_SHARED_ACCESS_SECRET=
HITS_PROPERTY_ID=
HITS_INTEGRATION_ENABLED=false
HITS_CHECKIN_ENABLED=false
HITS_REQUEST_TIMEOUT_MS=12000

# Contexto Datashare (headers Swagger) — preencher somente após confirmação HITS
HITS_API_VERSION=1
HITS_TENANT_NAME=
HITS_PROPERTY_CODE=
HITS_PARTNER_USER_ID=
HITS_CLIENT_ID=
HITS_LANGUAGE_CODE=pt-BR
# Escopos do /Authorize (CSV). Default interno: WebCheckIn
# HITS_AUTHORIZE_SCOPES=WebCheckIn

# Legado (não usar em código novo; preferir HITS_API_BASE_URL / HITS_SHARED_ACCESS_SECRET)
# HITS_BASE_URL=
# HITS_ACCESS_SECRET=

# TTLock Open Platform (Fase TTLock 2 - passcode temporário)
# Obtenha em open.ttlock.com / euopen.ttlock.com
TTLOCK_CLIENT_ID=
TTLOCK_CLIENT_SECRET=
TTLOCK_USERNAME=
TTLOCK_PASSWORD=
# Opcional; padrão: euapi.ttlock.com
# TTLOCK_TOKEN_URL=https://euapi.ttlock.com/oauth2/token
# TTLOCK_API_BASE_URL=https://euapi.ttlock.com

# Supabase (scripts de provisionamento)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp — MVP 3 Fase 4.2 (Meta Cloud API)
# true = mock (padrão); false = Meta Cloud API real
WHATSAPP_USE_MOCK=true
# Meta Cloud API (obrigatórios quando USE_MOCK=false)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Opcional; default: v21.0
WHATSAPP_GRAPH_API_VERSION=v21.0
# Webhook Meta: verificação GET (hub.verify_token) e assinatura POST (X-Hub-Signature-256)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
